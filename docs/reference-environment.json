    "text": "[sdl]\nautolock=false\nshowmenu=true\nmouse emulation=integration\n\n[dosbox]\ntitle=Yukon Trail reference\nmachine=svga_s3\nmemsize=16\ncaptures=/Users/miklosme/github/yukon-trail/local/evidence/reference\n\n[cpu]\ncore=normal\ncputype=pentium\ncycles=fixed 20000\nintegration device=true\n\n[sblaster]\nsbtype=sb16\nsbbase=220\nirq=7\ndma=1\nhdma=5\n\n[midi]\nmididevice=none\n\n[autoexec]\n@ECHO OFF\nMOUNT C /Users/miklosme/github/yukon-trail/local/emulator/windows\nIMGMOUNT D /Users/miklosme/github/yukon-trail/original/iso/YUKONCD.ISO -t iso\nC:\nSET BLASTER=A220 I7 D1 H5 P330 T6\nSET SOUND=C:\\SB16\nSET MIDI=SYNTH:1 MAP:E\nC:\\SB16\\DIAGNOSE /S\nC:\\SB16\\MIXERSET /P /Q\nSET PATH=%PATH%;C:\\WINDOWS\nSET TEMP=C:\\WINDOWS\\TEMP\nCD \\WINDOWS\nWIN\n",
    "settings": {
      "machine": "svga_s3",
      "ram_mb": 16,
      "cpu_type": "pentium",
      "core": "normal",
      "cycles": "fixed 20000",
      "c_drive": "mounted ignored host directory local/emulator/windows",
      "d_drive": "original/iso/YUKONCD.ISO mounted ISO before Windows",
      "network": "No guest networking configured",
      "external_midi": "none",
