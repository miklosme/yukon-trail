{
  // Browser port (web/), the Vite config and its TypeScript tooling (tools/*.ts).
  // Test scripts have their own looser config in tests/tsconfig.json.
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    // Bundler mode; Bun and Node type-stripping also run these files directly,
    // so only erasable TypeScript syntax is allowed (no enums/namespaces).
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // Recovered rules index typed arrays after explicit length checks that mirror
    // the original code; per-element undefined checks would obscure them.
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["web", "tools/**/*.ts", "vite.config.ts"]
}
